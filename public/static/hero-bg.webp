<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#060624"/>
      <stop offset="100%" stop-color="#0A0A40"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(56,225,255,0.15)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <rect width="800" height="600" fill="url(#grid)"/>
  <circle cx="400" cy="300" r="200" fill="none" stroke="rgba(29,169,228,0.3)" stroke-width="2"/>
  <circle cx="400" cy="300" r="120" fill="none" stroke="rgba(56,225,255,0.4)" stroke-width="1.5" stroke-dasharray="8 4"/>
  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#ffffff" font-family="system-ui, sans-serif" font-weight="900" font-size="28" letter-spacing="2">WATCHER IA // AGENTIC DATA FLOW</text>
  <text x="50%" y="58%" dominant-baseline="middle" text-anchor="middle" fill="#38E1FF" font-family="monospace" font-size="14" letter-spacing="1">WATCHER IA · AUTONOMOUS KERNEL</text>
</svg>